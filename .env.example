# Port this worker listens on. qa-agent-backend's AGENT_WORKER_BASE_URL must
# point here (e.g. http://localhost:4000).
PORT=4000

# Inbound: the backend sends this as "Authorization: Bearer ..." when it
# dispatches a run. Must equal AGENT_WORKER_API_TOKEN in the backend.
WORKER_API_TOKEN=

# Outbound: sent as X-Agent-Token when calling back into the backend.
# Must equal AGENT_API_TOKEN in the backend.
AGENT_API_TOKEN=

# Leave empty to use Playwright's Chromium (npm run setup), or set to "chrome"
# to use the Google Chrome installed on this machine instead.
BROWSER_CHANNEL=

# Set to false to watch the browser while it tests.
HEADLESS=true

# How far a run explores: pages loaded, and safe controls clicked per kind of page.
MAX_PAGES=15
MAX_CLICKS_PER_PAGE=12
MAX_CONCURRENT_RUNS=2

# Performance thresholds: API calls slower than this (ms) are reported, and so
# is the same request fired this many times by one view.
SLOW_REQUEST_MS=1000
REPEATED_REQUEST_THRESHOLD=3

# Backend probe (qa-agent-backend lib/qa_probe.rb): lets runs read per-request
# SQL / N+1 / exception / memory reports. Must equal the backend's QA_PROBE_TOKEN.
# Leave empty to test without backend instrumentation.
QA_PROBE_TOKEN=
MAX_QUERIES_PER_REQUEST=30
MAX_ALLOCATED_OBJECTS=500000
MAX_RSS_GROWTH_MB=50

# Browser memory: a leak is growth across repeated clicks after garbage
# collection; also flag pages holding more JS heap than MAX_HEAP_MB.
LEAK_HEAP_MB=5
LEAK_NODES=1000
LEAK_LISTENERS=100
MAX_HEAP_MB=150
